---
import { INITIAL_LEVEL, formatXp } from '../../lib/player-levels';
import Icon from './Icon.astro';

/**
 * Чип рівня гравця. Поки статичний «Акціонер · 0 XP»; рушій прогресу гідрує його за data-атрибутами:
 * [data-player-chip] → data-level-id, data-xp; тексти — [data-player-level], [data-player-xp].
 */
---

<span class="me" data-player-chip data-level-id={INITIAL_LEVEL.id} data-xp="0">
  <Icon name="hex" class="hex me-hex" />
  <span class="visually-hidden" data-player-sr>Ваш рівень: {INITIAL_LEVEL.title}, {formatXp(0)}</span>
  <span class="me-level" data-player-level aria-hidden="true">{INITIAL_LEVEL.title}</span>
  <span class="me-xp num" data-player-xp aria-hidden="true">{formatXp(0)}</span>
</span>
