---
import Crumbs from '../../components/site/Crumbs.astro';
import Icon from '../../components/site/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCourseData, type ModuleView } from '../../lib/course-data';
import { minutesLabel } from '../../lib/course-data-pure';
import { pluralUk } from '../../lib/plural';
import { typo } from '../../lib/typography';
import { url } from '../../lib/url';
import '../../styles/topic.css';

export async function getStaticPaths() {
  const { modules } = await loadCourseData();
  return modules.map((module) => ({ params: { module: module.id }, props: { module } }));
}

interface Props {
  module: ModuleView;
}

const { module } = Astro.props;
const { course, modules } = await loadCourseData();
const moduleTest = course.grading.categories.find((category) => category.id === 'module-tests');
const published = module.topics.filter((topic) => topic.lecture);
const totalMinutes = published.reduce((sum, topic) => sum + (topic.readingMinutes ?? 0), 0);
const prev = modules[module.number - 2];
const next = modules[module.number];
const description = typo(`Модуль ${module.number} курсу «${course.title}»: ${module.topics.map((t) => t.title).join('; ')}.`);
---

<BaseLayout title={`Модуль ${module.number}. ${module.title} — ${course.title}`} description={description} current="topics">
  <div class="container" data-module-page data-module={module.id}>
    <Crumbs items={[{ label: 'Курс', href: url() }, { label: 'Теми', href: url('temy/') }, { label: `Модуль ${module.number}` }]} />
    <header class="topic-head">
      <p class="kicker">Модуль {module.number} із {modules.length}</p>
      <h1 class="h1 module-title"><span class="n">М{module.number}.</span>{typo(module.title)}</h1>
      <div class="topic-facts">
        <span><Icon name="list" />{pluralUk(module.topics.length, { one: 'тема', few: 'теми', many: 'тем', other: 'теми' })}</span>
        <span><Icon name="clock" />{published.length > 0 ? `${minutesLabel(totalMinutes)} читання` : 'лекції готуються'}</span>
        {moduleTest && <span><Icon name="flag" />модульний тест: {pluralUk(moduleTest.pointsPerItem, { one: 'бал', few: 'бали', many: 'балів', other: 'бала' })}</span>}
      </div>
    </header>

    <div class="layout">
      <div>
        <ol class="module-topics" aria-label={`Теми модуля ${module.number}`}>
          {
            module.topics.map((topic) => (
              <li>
                <a class="topic module-topic" href={url(`temy/${topic.slug}/`)} data-topic={topic.id} data-state="todo">
                  <span class="mark mark-todo" data-topic-mark role="img" aria-label="Не розпочато" />
                  <span>
                    <span class="topic-title">
                      <span class="n">{topic.number}.</span>
                      {typo(topic.title)}
                    </span>
                    <span class="module-topic-summary">{typo(topic.summary)}</span>
                    <span class="topic-meta">
                      <span>{topic.readingMinutes ? `${minutesLabel(topic.readingMinutes)} читання` : 'лекція готується'}</span>
                      {topic.termCount > 0 && <span>{pluralUk(topic.termCount, { one: 'термін', few: 'терміни', many: 'термінів', other: 'терміна' })}</span>}
                      <span data-topic-progress={topic.id} />
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>

        <nav class="pager" aria-label="Сусідні модулі">
          {
            prev ? (
              <a href={url(`moduli/${prev.id}/`)}>
                <small>Попередній модуль</small>
                <b>М{prev.number}. {typo(prev.title)}</b>
              </a>
            ) : (
              <span>
                <small>Попередній модуль</small>
                <b>— початок курсу —</b>
              </span>
            )
          }
          {
            next ? (
              <a class="next" href={url(`moduli/${next.id}/`)}>
                <small>Наступний модуль</small>
                <b>М{next.number}. {typo(next.title)}</b>
              </a>
            ) : (
              <span class="next">
                <small>Наступний модуль</small>
                <b>— кінець курсу —</b>
              </span>
            )
          }
        </nav>
      </div>

      <aside class="side" aria-label="Про модуль">
        <div class="side-block side-progress" data-module-progress-card={module.id}>
          <div class="row"><b>Пройдено тем</b><span class="num" data-module-progress-label>0 із {module.topics.length}</span></div>
          <div class="meter" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax={module.topics.length} aria-label="Пройдено тем модуля" data-module-progress-meter><i style="width:0%"></i></div>
          <div class="faint">Стан зберігається у вашому браузері</div>
        </div>
        <div class="side-block">
          <h2>Модульний тест</h2>
          <p class="small muted">{typo(`Після трьох тем — тест на ${moduleTest?.pointsPerItem ?? 6} балів: 15 випадкових питань з банку модуля, 30 хвилин.`)}</p>
          <p class="soon" data-module-quiz={module.id}>незабаром</p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .module-topics { display: grid; border-top: 1px solid var(--rule); }
  .module-topics li { margin: 0; }
  .module-topic { padding: var(--s-4) 0; }
  .module-topic :global(.topic-title) { font-size: var(--text-md); font-weight: 600; }
  .module-topic-summary { display: block; margin-top: 0.3rem; font-size: var(--text-sm); color: var(--ink-2); line-height: 1.45; text-wrap: pretty; max-width: 62ch; }
  .side p + p { margin-top: var(--s-2); }
</style>
