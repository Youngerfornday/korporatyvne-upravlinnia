{
  "name": "korporatyvne-upravlinnia",
  "version": "0.1.0",
  "private": true,
  "description": "Навчальний курс «Корпоративне управління» для бакалаврату: сайт, тренувальні банки питань і пакети для Moodle",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node tools/checks/content-lint.mjs --warn-only && astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "playwright test --config playwright.live.config.ts",
    "check:dist": "node tools/checks/check-dist.mjs",
    "lint:typography": "node tools/checks/typography-lint.mjs",
    "lint:content": "node tools/checks/content-lint.mjs",
    "test:export": "vitest run --config tools/export/vitest.config.ts",
    "test:export:coverage": "vitest run --config tools/export/vitest.config.ts --coverage",
    "export:moodle": "node --import ./tools/export/register-ts.mjs tools/export/cli.ts",
    "export:book": "node --import ./tools/export/register-ts.mjs tools/export/book-cli.ts",
    "build:downloads": "node --import ./tools/export/register-ts.mjs tools/export/downloads.ts",
    "moodle:import-check": "tools/moodle/import-check.sh",
    "moodle:build": "tools/moodle/build-mbz.sh",
    "moodle:verify": "tools/moodle/verify-course.sh",
    "test:e2e": "playwright test --config e2e/site/playwright.config.ts",
    "screens": "node e2e/site/screens.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.2",
    "fflate": "0.8.3",
    "pptxgenjs": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satteri": "0.10.5",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "docx": "9.7.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
