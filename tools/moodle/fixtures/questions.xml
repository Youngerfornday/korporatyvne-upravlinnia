  <!-- 5. Числова з допуском (apply). У мові uk студент вводить 1,5 -->
  <question type="numerical">
    <name><text>Т01 numerical: частка голосів</text></name>
    <questiontext format="html"><text><![CDATA[<p>Акціонер володіє 15 акціями з 1000 голосуючих. Яку частку голосів (у відсотках) він має? Відповідь дайте числом, наприклад 2,5.</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>15 / 1000 × 100 = 1,5 %.</p>]]></text></generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0</penalty>
    <hidden>0</hidden>
    <idnumber>SPIKE-T01-Q05</idnumber>
    <answer fraction="100" format="moodle_auto_format">
      <text>1.5</text>
      <feedback format="html"><text>Правильно.</text></feedback>
      <tolerance>0.01</tolerance>
    </answer>
    <unitgradingtype>0</unitgradingtype>
    <unitpenalty>0.1</unitpenalty>
    <showunits>3</showunits>
    <unitsleft>0</unitsleft>
    <tags>
      <tag><text>bloom-apply</text></tag>
    </tags>
  </question>

