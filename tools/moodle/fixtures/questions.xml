  <!-- 1. Одиночний вибір (remember) -->
  <question type="multichoice">
    <name><text>Т01 single: агентська проблема</text></name>
    <questiontext format="html"><text><![CDATA[<p>Яке визначення найточніше описує агентську проблему в корпорації?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Агентська проблема виникає через розбіжність інтересів власників і найманих менеджерів.</p>]]></text></generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0</penalty>
    <hidden>0</hidden>
    <idnumber>SPIKE-T01-Q01</idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>0</showstandardinstruction>
    <correctfeedback format="html"><text>Правильно.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Частково правильно.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Неправильно.</text></incorrectfeedback>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Конфлікт інтересів між власниками та менеджерами, яким делеговано контроль</p>]]></text>
      <feedback format="html"><text>Так, це класичне визначення.</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Конфлікт між двома конкурентами на ринку</p>]]></text>
      <feedback format="html"><text>Це конкуренція, а не агентська проблема.</text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Спір між державою та платником податків</p>]]></text>
      <feedback format="html"><text>Це податкові відносини.</text></feedback>
    </answer>
    <tags>
      <tag><text>bloom-remember</text></tag>
    </tags>
  </question>

