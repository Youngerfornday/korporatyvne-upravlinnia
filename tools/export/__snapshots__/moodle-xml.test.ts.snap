    <incorrectfeedback format="html"><text><![CDATA[<p>Неправильно.</p>]]></text></incorrectfeedback>
    <answer fraction="100" format="html">
      <text><![CDATA[Загальні збори акціонерів]]></text>
      <feedback format="html"><text><![CDATA[<p>Так, це вищий орган товариства.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Наглядова рада]]></text>
      <feedback format="html"><text><![CDATA[<p>Наглядова рада контролює виконавчий орган.</p>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Виконавчий орган]]></text>
      <feedback format="html"><text><![CDATA[<p>Виконавчий орган керує поточною діяльністю.</p>]]></text></feedback>
    </answer>
    <tags>
      <tag><text>bloom-remember</text></tag>
      <tag><text>topic-t04</text></tag>
    </tags>
  </question>
</quiz>
"
`;

